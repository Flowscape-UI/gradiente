    "@types/culori": "^4.0.1",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "culori": "^4.0.2"
  }
}
